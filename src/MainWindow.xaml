<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iPhone Mirror" Width="550" Height="760" MinWidth="500" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#F6F7FB" FontFamily="Malgun Gothic"
        Foreground="#202438" FontSize="14">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="18,11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="#E9ECF5"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.84"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,0,0,12"/></Style>
  </Window.Resources>
  <ScrollViewer Background="#F6F7FB" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="30,26,30,24">
      <DockPanel Margin="0,0,0,24">
        <Border Width="48" Height="48" CornerRadius="14" Background="#E5E2FF" DockPanel.Dock="Left" Margin="0,0,14,0">
          <Grid>
            <Border Width="18" Height="29" CornerRadius="4" BorderThickness="2" BorderBrush="#6557DB"/>
            <Border Width="8" Height="2" Background="#6557DB" VerticalAlignment="Bottom" Margin="0,0,0,13"/>
          </Grid>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="iPhone Mirror" FontSize="23" FontWeight="SemiBold"/>
          <TextBlock Text="아이폰 화면을 윈도우로" Foreground="#71788D" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>
      </DockPanel>
      <Border Background="White" BorderBrush="#E6E9F1" BorderThickness="1" CornerRadius="18" Padding="24">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Fill="#9AA2B4" Width="8" Height="8" Margin="0,0,8,0"/>
            <TextBlock x:Name="StatusText" Text="시작할 준비가 되었습니다" FontWeight="SemiBold"/>
          </StackPanel>
          <TextBlock Text="화면 미러링에서 선택할 이름" Foreground="#71788D" FontSize="12" Margin="0,22,0,6"/>
          <TextBlock Text="iPhone Mirror" FontSize="27" FontWeight="SemiBold"/>
          <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="연결 코드" Foreground="#71788D" FontSize="12"/>
              <TextBlock x:Name="CodeText" Text="— — — — — —" FontFamily="Consolas" FontSize="26" Foreground="#6557DB" Margin="0,6,0,0"/>
            </StackPanel>
            <Button x:Name="StartButton" Grid.Column="1" Content="미러링 시작" Background="#6557DB" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </Grid>
          <TextBlock x:Name="DetailText" Text="같은 공유기에 연결해 주세요. 시작 시 임시 방화벽 허용을 위한 관리자 승인이 필요합니다." Foreground="#71788D" FontSize="12" Margin="0,18,0,0"/>
        </StackPanel>
      </Border>
      <TextBlock Text="아이폰에서 연결하기" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,16"/>
      <TextBlock Text="1   아이폰과 PC를 같은 공유기에 연결합니다." Margin="0,0,0,11"/>
      <TextBlock Text="2   아이폰 제어 센터에서 ‘화면 미러링’을 누릅니다." Margin="0,0,0,11"/>
      <TextBlock Text="3   ‘iPhone Mirror’를 선택하고 연결 코드를 입력합니다." Margin="0,0,0,11"/>
      <TextBlock Foreground="#71788D" FontSize="12" Margin="0,0,0,20" LineHeight="19">연결되면 아이폰 화면이 별도 창으로 열립니다.<LineBreak/>아이폰 잠금을 해제한 상태로 시작해 주세요.</TextBlock>
      <Border Background="#ECEEF6" CornerRadius="12" Padding="16,14" Margin="0,0,0,18">
        <StackPanel>
          <CheckBox x:Name="AudioCheck" Content="아이폰 소리도 PC에서 재생"/>
          <CheckBox x:Name="SoftwareCheck" Content="화면이 검게 나오면 호환 모드 사용" Margin="0"/>
        </StackPanel>
      </Border>
      <DockPanel>
        <Button x:Name="HelpButton" Content="연결 도움말" Padding="14,9" DockPanel.Dock="Left"/>
        <Button x:Name="LogButton" Content="진단 로그" Padding="14,9" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
      </DockPanel>
      <TextBlock Text="미리보기 0.1 · 화면 보기 단계" Foreground="#8B92A3" FontSize="11" Margin="0,20,0,0" HorizontalAlignment="Center"/>
    </StackPanel>
  </ScrollViewer>
</Window>
